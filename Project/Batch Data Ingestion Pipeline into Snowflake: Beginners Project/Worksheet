-- Create a Database and Schema
CREATE or REPLACE DATABASE demo_db;
USE DATABASE demo_db;

CREATE or REPLACE SCHEMA demo_schema;
USE SCHEMA demo_schema;

-- Create a Table in Snowflake
CREATE OR REPLACE TABLE employees (
    emp_id INT,
    first_name STRING,
    last_name STRING,
    department STRING,
    salary NUMBER,
    hire_date DATE
);

-- create a file format
CREATE OR REPLACE FILE FORMAT my_csv_format
  TYPE = 'CSV'
  FIELD_DELIMITER = ','
  SKIP_HEADER = 1
  FIELD_OPTIONALLY_ENCLOSED_BY = '"'
  TRIM_SPACE = TRUE
  EMPTY_FIELD_AS_NULL = TRUE
  COMPRESSION = 'AUTO';

-- Create STORAGE_INTEGRATION:
CREATE OR REPLACE STORAGE INTEGRATION my_s3_integration
  TYPE = EXTERNAL_STAGE
  STORAGE_PROVIDER = S3
  ENABLED = TRUE
  STORAGE_AWS_ROLE_ARN = 'arn:aws:iam::490004657759:role/aws_data_ingestion'
  STORAGE_ALLOWED_LOCATIONS = ('s3://my-snowflake-demo-bucket/sourcefolder/');


-- Create an External Stage
CREATE OR REPLACE STAGE my_s3_stage
  FILE_FORMAT = my_csv_format
  URL = 's3://my-snowflake-demo-bucket/sourcefolder/'
  STORAGE_INTEGRATION = my_s3_integration;


SHOW STAGES;

-- Use this to get External ID
DESC INTEGRATION my_s3_integration;

-- See Data Privew
LIST @my_s3_stage;

SELECT $1, $2, $3 FROM @my_s3_stage;

-- Copy data into table from stage
COPY INTO employees
FROM @my_s3_stage;

-- Query table data
SELECT * FROM employees;

-- If you want to delete everything created for this demo:
DROP STAGE IF EXISTS my_s3_stage;
DROP FILE FORMAT IF EXISTS my_csv_format;
DROP STORAGE INTEGRATION IF EXISTS my_s3_integration;
DROP TABLE IF EXISTS employees;
-- Drop schema (if exists)
DROP SCHEMA IF EXISTS demo_schema CASCADE;
-- Drop database (if exists)
DROP DATABASE IF EXISTS demo_db CASCADE;

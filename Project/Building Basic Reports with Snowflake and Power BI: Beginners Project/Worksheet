-- see the data
SELECT * FROM SALES_DB.SALES_SCHEMA.SALES_DATA;

-- create View for Sales by Region
CREATE OR REPLACE VIEW SALES_DB.SALES_SCHEMA.SALES_BY_REGION AS
SELECT REGION, 
       SUM(QUANTITY * PRICE) AS TOTAL_SALES
FROM SALES_DB.SALES_SCHEMA.SALES_DATA
GROUP BY REGION;

-- create View for Monthly Revenue Trends
CREATE OR REPLACE VIEW SALES_DB.SALES_SCHEMA.MONTHLY_REVENUE AS
SELECT DATE_TRUNC('month', ORDER_DATE) AS MONTH,
       SUM(QUANTITY * PRICE) AS MONTHLY_REVENUE
FROM SALES_DB.SALES_SCHEMA.SALES_DATA
GROUP BY DATE_TRUNC('month', ORDER_DATE)
ORDER BY MONTH;

-- create View for Product Performance
CREATE OR REPLACE VIEW SALES_DB.SALES_SCHEMA.PRODUCT_PERFORMANCE AS
SELECT PRODUCT, 
       SUM(QUANTITY) AS TOTAL_QUANTITY,
       SUM(QUANTITY * PRICE) AS TOTAL_REVENUE
FROM SALES_DB.SALES_SCHEMA.SALES_DATA
GROUP BY PRODUCT;

-- If you want to delete everything created for this demo:
DROP TABLE SALES_DATA;
DROP SCHEMA SALES_SCHEMA;
DROP DATABASE SALES_DB;
